<h2><%= l(:label_qr_scanner) %></h2>

<p><%= l(:text_qr_scanner_inspect_hint) %></p>

<%# position: relative here, not on #qr-reader itself, so the result
    overlay below can cover exactly the frame Html5QrcodeScanner draws
    into without ever touching that element's own children - it clears
    and rebuilds its own DOM at various points in its lifecycle (start,
    pause, resume), so anything of ours placed inside #qr-reader itself
    would risk being wiped out along with it. %>
<div id="qr-scan-wrapper" style="position: relative; width: 100%;">
  <%# Html5QrcodeScanner (the library's own high-level widget) draws its
      own start button, camera picker, and viewfinder inside this element.
      Width is the only dimension forced here, on purpose - see
      show.html.erb's own comment: forcing a fixed viewport-relative
      height once stopped the camera from starting at all on phones. %>
  <div id="qr-reader" style="width: 100%;"></div>

  <%# The result overlay: hidden until a scan comes back, then covers the
      whole frame above. Unlike show.html.erb's scanner, tapping the
      overlay itself does nothing here - there's a real choice to make
      (decrement or not), so both options are their own explicit,
      clearly-labeled buttons rather than an ambiguous "tap anywhere"
      that could be triggered without meaning to, or missed as an option
      at all. %>
  <div id="qr-scan-result" class="qr-scan-result">
    <dl id="qr-scan-details" class="qr-scan-kv">
      <dt><%= l(:label_qr_scanner_issue_prefix) %></dt>
      <dd id="qr-scan-subject"></dd>
      <dt><%= l(:label_qr_scanner_status_prefix) %></dt>
      <dd id="qr-scan-status"></dd>
      <dt id="qr-scan-field-name"></dt>
      <dd id="qr-scan-field-value"></dd>
    </dl>
    <p id="qr-scan-message"></p>
    <div class="qr-scan-buttons">
      <button type="button" id="qr-scan-decrement"><%= l(:button_qr_scanner_decrement) %></button>
      <button type="button" id="qr-scan-skip"><%= l(:button_qr_scanner_skip) %></button>
    </div>
  </div>
</div>

<%# Two forms sharing the same hidden url field's value at post time -
    one for the read-only lookup a scan always does, one for the actual
    decrement, only ever submitted from the "Decrement" button's own
    click handler. See QrScannerController#inspect_scan's comment: that
    action never writes anything - the second form, posting to `scan`
    (the exact endpoint show.html.erb's scanner uses), is the only path
    to a write on this page, and it only ever fires from one explicit,
    labeled button. %>
<%= form_tag(inspect_scan_qr_scanner_path, id: 'qr-scan-form', style: 'display: none') do %>
  <%= hidden_field_tag :url, '', id: 'qr-scan-url' %>
<% end %>
<%= form_tag(scan_qr_scanner_path, id: 'qr-decrement-form', style: 'display: none') do %>
  <%= hidden_field_tag :url, '', id: 'qr-decrement-url' %>
<% end %>

<style>
  /* Redmine's own #content padding (application.css) reads as a wasted
     margin around something meant to fill the page - scoped to this one
     controller/action via the body classes Redmine's layout already adds
     (see application_helper.rb#body_css_classes), so nothing else is
     affected. */
  body.controller-qr_scanner.action-inspect #content {
    padding-left: 0;
    padding-right: 0;
  }

  .qr-scan-result {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1em;
    text-align: center;
    color: #fff;
  }
  /* Neutral blue while there's a decision still to make - this state
     isn't "success" or "failure" of anything yet, just information.
     Errors (not a recognized issue) and the eventual decrement outcome
     both reuse the decrement page's own green/red. */
  .qr-scan-result.-info { background: rgba(49, 112, 143, 0.92); }
  .qr-scan-result.-success { background: rgba(60, 118, 61, 0.92); }
  .qr-scan-result.-error { background: rgba(169, 68, 66, 0.92); }

  .qr-scan-kv {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0.3em 0.8em;
    justify-content: center;
    margin: 0 0 1em 0;
    font-size: 1.2em;
  }
  .qr-scan-kv dt { font-weight: normal; opacity: 0.85; text-align: right; }
  .qr-scan-kv dd { margin: 0; font-weight: bold; text-align: left; }

  #qr-scan-message { font-size: 1.3em; margin-bottom: 0.5em; }

  .qr-scan-buttons { display: flex; gap: 1em; justify-content: center; flex-wrap: wrap; }
  /* Same core-CSS-vs-<button> specificity issue as the decrement page -
     see that file's own history for the full explanation: Redmine's
     `input, select, button { height: 24px; ... }` isn't tall enough for
     this padding/font-size, so text overflows below the button unless
     height is reset. */
  .qr-scan-buttons button {
    height: auto;
    padding: 0.6em 1.6em;
    font-size: 1.1em;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }
  #qr-scan-decrement { background: #a94442; color: #fff; }
  #qr-scan-skip { background: rgba(255, 255, 255, 0.15); color: #fff; }
  .qr-scan-buttons button:disabled { opacity: 0.6; cursor: default; }
</style>

<script>
<%= raw QrScannerController.vendored_javascript %>
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var scanner = new Html5QrcodeScanner('qr-reader', {
      fps: 10,
      // A fixed pixel qrbox would look lost (or too cramped) once the
      // frame itself scales with the viewport - sizing it as a fraction
      // of whatever the viewfinder actually turns out to be keeps the
      // aiming box proportionate at any screen size.
      qrbox: function (viewfinderWidth, viewfinderHeight) {
        var edge = Math.floor(Math.min(viewfinderWidth, viewfinderHeight) * 0.7);
        return { width: edge, height: edge };
      }
    });

    var resultEl = document.getElementById('qr-scan-result');
    var detailsEl = document.getElementById('qr-scan-details');
    var subjectEl = document.getElementById('qr-scan-subject');
    var statusEl = document.getElementById('qr-scan-status');
    var fieldNameEl = document.getElementById('qr-scan-field-name');
    var fieldValueEl = document.getElementById('qr-scan-field-value');
    var messageEl = document.getElementById('qr-scan-message');
    var decrementButton = document.getElementById('qr-scan-decrement');
    var skipButton = document.getElementById('qr-scan-skip');
    var lookupForm = document.getElementById('qr-scan-form');
    var lookupUrlField = document.getElementById('qr-scan-url');
    var decrementForm = document.getElementById('qr-decrement-form');
    var decrementUrlField = document.getElementById('qr-decrement-url');

    var requestFailedMessage = <%= l(:error_qr_scanner_request_failed).to_json.html_safe %>;
    var continueLabel = <%= l(:button_qr_scanner_continue).to_json.html_safe %>;

    // Guards against the decode loop firing again for the same code a
    // frame or two after a scan is already being handled, before
    // scanner.pause() below has actually taken effect.
    var handlingScan = false;

    function dismissAndResume() {
      resultEl.style.display = 'none';
      handlingScan = false;
      scanner.resume();
    }

    function showInfo(data) {
      detailsEl.style.display = '';
      messageEl.style.display = 'none';
      subjectEl.textContent = '#' + data.issue_id + ' ' + data.issue_subject;
      statusEl.textContent = data.issue_status;

      if (data.field_name) {
        fieldNameEl.textContent = data.field_name + ':';
        fieldValueEl.textContent = data.field_value;
        fieldNameEl.style.display = '';
        fieldValueEl.style.display = '';
      } else {
        fieldNameEl.style.display = 'none';
        fieldValueEl.style.display = 'none';
      }

      decrementButton.style.display = data.can_decrement ? '' : 'none';
      skipButton.textContent = <%= l(:button_qr_scanner_skip).to_json.html_safe %>;
      resultEl.className = 'qr-scan-result -info';
      resultEl.style.display = 'flex';
    }

    function showOutcome(status, message) {
      detailsEl.style.display = 'none';
      messageEl.style.display = '';
      messageEl.textContent = message;
      decrementButton.style.display = 'none';
      decrementButton.disabled = false;
      skipButton.disabled = false;
      skipButton.textContent = continueLabel;
      resultEl.className = 'qr-scan-result -' + status;
      resultEl.style.display = 'flex';

      if (status === 'success' && navigator.vibrate) {
        navigator.vibrate(200);
      }
    }

    scanner.render(function (decodedText) {
      if (handlingScan) return;
      handlingScan = true;

      // true also freezes the visible preview on the last frame, which
      // is itself a clear "this is paused" signal, not just a mechanism
      // to stop decoding.
      try { scanner.pause(true); } catch (e) { /* already paused/stopped */ }

      lookupUrlField.value = decodedText;
      decrementUrlField.value = decodedText;

      fetch(lookupForm.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(lookupForm)
      })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (data.status === 'success') {
            showInfo(data);
          } else {
            showOutcome('error', data.message);
          }
        })
        .catch(function () {
          showOutcome('error', requestFailedMessage);
        });
    });

    skipButton.addEventListener('click', dismissAndResume);

    decrementButton.addEventListener('click', function () {
      decrementButton.disabled = true;
      skipButton.disabled = true;

      fetch(decrementForm.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(decrementForm)
      })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          var message = data.field_name ? (data.field_name + ': ' + data.field_value) : data.message;
          showOutcome(data.status, message);
        })
        .catch(function () {
          showOutcome('error', requestFailedMessage);
        });
    });
  });
</script>

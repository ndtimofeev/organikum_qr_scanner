<h2><%= l(:label_qr_scanner) %></h2>

<%# See show.html.erb's own comment on this banner - same mechanism,
    opposite direction. Read-only here isn't a claim this banner makes on
    its own: it's true because QrScannerController#inspect_scan (what
    this page posts to) contains no code path that writes anything. %>
<div class="qr-scanner-mode-bar -inspect">
  <strong><%= l(:label_qr_scanner_mode_inspect) %></strong>
  <%= link_to l(:link_qr_scanner_switch_to_decrement), qr_scanner_path %>
</div>

<p><%= l(:text_qr_scanner_inspect_hint) %></p>

<%# position: relative here, not on #qr-reader itself, so the result
    overlay below can cover exactly the frame Html5QrcodeScanner draws
    into without ever touching that element's own children - it clears
    and rebuilds its own DOM at various points in its lifecycle (start,
    pause, resume), so anything of ours placed inside #qr-reader itself
    would risk being wiped out along with it. %>
<div id="qr-scan-wrapper" style="position: relative; width: 100%;">
  <%# Html5QrcodeScanner (the library's own high-level widget) draws its
      own start button, camera picker, and viewfinder inside this element.
      Width is the only dimension forced here, on purpose - see
      show.html.erb's own comment: forcing a fixed viewport-relative
      height once stopped the camera from starting at all on phones. %>
  <div id="qr-reader" style="width: 100%;"></div>

  <%# The result overlay: hidden until a scan comes back, then covers the
      whole frame above. On success, shows subject/status/field instead
      of a single message; on error (not a recognized issue), shows just
      the message, styled the same way the decrement page's errors are. %>
  <div id="qr-scan-result" class="qr-scan-result">
    <div id="qr-scan-details">
      <p id="qr-scan-subject"></p>
      <p id="qr-scan-status"></p>
      <p id="qr-scan-field"></p>
    </div>
    <p id="qr-scan-message"></p>
    <button type="button" id="qr-scan-continue"><%= l(:button_qr_scanner_continue) %></button>
  </div>
</div>

<%# A real form (form_tag embeds the CSRF token automatically) - but
    submitted via fetch (see below) rather than a real navigation, so the
    result can be shown without leaving this page and the camera can be
    paused/resumed instead of torn down and rebuilt. %>
<%= form_tag(inspect_scan_qr_scanner_path, id: 'qr-scan-form', style: 'display: none') do %>
  <%= hidden_field_tag :url, '', id: 'qr-scan-url' %>
<% end %>

<style>
  .qr-scanner-mode-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5em 1em;
    padding: 0.6em 1em;
    margin-bottom: 1em;
    border-radius: 4px;
    color: #fff;
  }
  .qr-scanner-mode-bar.-decrement { background: #a94442; }
  .qr-scanner-mode-bar.-inspect { background: #31708f; }
  .qr-scanner-mode-bar a { color: #fff; text-decoration: underline; }

  /* Redmine's own #content padding (application.css) reads as a wasted
     margin around something meant to fill the page - scoped to this one
     controller/action via the body classes Redmine's layout already adds
     (see application_helper.rb#body_css_classes), so nothing else is
     affected. */
  body.controller-qr_scanner.action-inspect #content {
    padding-left: 0;
    padding-right: 0;
  }

  .qr-scan-result {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1em;
    text-align: center;
    color: #fff;
  }
  /* Neutral blue for a found issue - this page never signals
     success/failure of an action, since it never takes one; blue reads
     as "here's what's on it", not "this went well". Errors (not a
     recognized issue) still use the same red as the decrement page's,
     since "that's not a ticket" really is an error here too. */
  .qr-scan-result.-success { background: rgba(49, 112, 143, 0.92); }
  .qr-scan-result.-error { background: rgba(169, 68, 66, 0.92); }
  .qr-scan-result p { font-size: 1.3em; margin-bottom: 0.5em; }
  #qr-scan-subject { font-size: 1.6em; font-weight: bold; margin-bottom: 0.3em; }
  /* Same core-CSS-vs-<button> specificity issue as the decrement page -
     see that file's comment for the full explanation. */
  .qr-scan-result button {
    height: auto;
    margin-top: 0.5em;
    padding: 0.6em 2em;
    font-size: 1.2em;
  }
</style>

<script>
<%= raw QrScannerController.vendored_javascript %>
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var scanner = new Html5QrcodeScanner('qr-reader', {
      fps: 10,
      // A fixed pixel qrbox would look lost (or too cramped) once the
      // frame itself scales with the viewport - sizing it as a fraction
      // of whatever the viewfinder actually turns out to be keeps the
      // aiming box proportionate at any screen size.
      qrbox: function (viewfinderWidth, viewfinderHeight) {
        var edge = Math.floor(Math.min(viewfinderWidth, viewfinderHeight) * 0.7);
        return { width: edge, height: edge };
      }
    });
    var resultEl = document.getElementById('qr-scan-result');
    var detailsEl = document.getElementById('qr-scan-details');
    var subjectEl = document.getElementById('qr-scan-subject');
    var statusEl = document.getElementById('qr-scan-status');
    var fieldEl = document.getElementById('qr-scan-field');
    var messageEl = document.getElementById('qr-scan-message');
    var continueButton = document.getElementById('qr-scan-continue');
    var form = document.getElementById('qr-scan-form');
    var urlField = document.getElementById('qr-scan-url');

    // Guards against the decode loop firing again for the same code a
    // frame or two after a scan is already being handled, before
    // scanner.pause() below has actually taken effect.
    var handlingScan = false;

    function showResult(data) {
      var isError = data.status !== 'success';
      detailsEl.style.display = isError ? 'none' : '';
      messageEl.style.display = isError ? '' : 'none';

      if (isError) {
        messageEl.textContent = data.message;
      } else {
        subjectEl.textContent = '#' + data.issue_id + ' ' + data.issue_subject;
        statusEl.textContent = <%= l(:label_qr_scanner_status_prefix).to_json.html_safe %> + ' ' + data.issue_status;
        if (data.field_name) {
          fieldEl.textContent = data.field_name + ': ' + data.field_value;
          fieldEl.style.display = '';
        } else {
          fieldEl.style.display = 'none';
        }
      }

      resultEl.className = 'qr-scan-result -' + data.status;
      resultEl.style.display = 'flex';
    }

    scanner.render(function (decodedText) {
      if (handlingScan) return;
      handlingScan = true;

      // true also freezes the visible preview on the last frame, which
      // is itself a clear "this is paused" signal, not just a mechanism
      // to stop decoding.
      try { scanner.pause(true); } catch (e) { /* already paused/stopped */ }

      urlField.value = decodedText;

      fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form)
      })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          showResult(data);
        })
        .catch(function () {
          showResult({ status: 'error', message: <%= l(:error_qr_scanner_request_failed).to_json.html_safe %> });
        });
    });

    continueButton.addEventListener('click', function () {
      resultEl.style.display = 'none';
      handlingScan = false;
      scanner.resume();
    });
  });
</script>

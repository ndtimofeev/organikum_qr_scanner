<h2>
  <%= l(:label_qr_scanner_decrement) %>
  <%# Riding on the heading's own line rather than a paragraph/banner of
      its own - see inspect.html.erb for the other direction and the
      fuller reasoning. %>
  <small class="qr-scanner-switch"><%= link_to l(:link_qr_scanner_to_inspect), inspect_qr_scanner_path %></small>
</h2>

<%# position: relative here, not on #qr-reader itself, so the result
    overlay below can cover exactly the frame Html5QrcodeScanner draws
    into without ever touching that element's own children - it clears
    and rebuilds its own DOM at various points in its lifecycle (start,
    pause, resume), so anything of ours placed inside #qr-reader itself
    would risk being wiped out along with it. %>
<div id="qr-scan-wrapper" style="position: relative; width: 100%;">
  <%# Html5QrcodeScanner (the library's own high-level widget) draws its
      own start button, camera picker, and viewfinder inside this element -
      there is nothing else for this plugin to build a UI around. Width is
      the only dimension forced here, on purpose: an earlier version also
      forced a fixed viewport-relative height (plus object-fit: cover on
      the library's own <video>) to make the frame fill more of the page,
      and that stopped the camera from starting at all on phones while
      still working on desktop - forcing an unnaturally tall aspect ratio
      onto the container most likely made the library request a camera
      resolution/aspect ratio mobile hardware couldn't satisfy, something
      a wide desktop webcam tolerates far more easily. Left at its natural
      width-driven, aspect-ratio-preserving size instead; still noticeably
      larger than the old fixed 500px box simply because #content is no
      longer artificially narrowed (see the CSS below). %>
  <div id="qr-reader" style="width: 100%;"></div>

  <%# The result overlay: hidden until a scan comes back, then covers the
      whole frame above. There is nothing to decide here - this scanner
      always just decrements and reports what happened - so the entire
      overlay is the "continue" control: tapping anywhere on it resumes
      scanning. No separate button competing for space or attention;
      the "tap anywhere" hint text is there purely so that's obvious on
      first use. Deliberately not a Redmine flash message (those only
      survive one redirect) - this page never navigates away, so the
      result has to live in the page itself. %>
  <div id="qr-scan-result" class="qr-scan-result">
    <p id="qr-scan-message"></p>
    <p class="qr-scan-hint"><%= l(:text_qr_scanner_tap_to_continue) %></p>
  </div>
</div>

<%# A real form (form_tag embeds the CSRF token automatically) - but
    submitted via fetch (see below) rather than a real navigation, so the
    result can be shown without leaving this page and the camera can be
    paused/resumed instead of torn down and rebuilt. %>
<%= form_tag(scan_qr_scanner_path, id: 'qr-scan-form', style: 'display: none') do %>
  <%= hidden_field_tag :url, '', id: 'qr-scan-url' %>
<% end %>

<style>
  /* Redmine's own #content padding (application.css) reads as a wasted
     margin around something meant to fill the page - scoped to this one
     controller/action via the body classes Redmine's layout already adds
     (see application_helper.rb#body_css_classes), so nothing else is
     affected. */
  body.controller-qr_scanner.action-show #content {
    padding-left: 0;
    padding-right: 0;
  }

  /* Deliberately subordinate to the heading it rides on - smaller and
     muted, so the page's own name stays the visually dominant thing on
     this line, and the link to the other scanner reads as a secondary,
     always-available option rather than competing for attention. */
  .qr-scanner-switch {
    margin-left: 0.5em;
    font-size: 0.55em;
    font-weight: normal;
    opacity: 0.75;
  }
  .qr-scanner-switch:before { content: "\2192\00a0"; } /* → (non-breaking space after) */

  .qr-scan-result {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1em;
    text-align: center;
    color: #fff;
    cursor: pointer;
  }
  .qr-scan-result.-success { background: rgba(60, 118, 61, 0.92); }
  .qr-scan-result.-error { background: rgba(169, 68, 66, 0.92); }
  .qr-scan-result p { font-size: 1.3em; margin-bottom: 0.5em; }
  .qr-scan-result .qr-scan-hint { font-size: 0.9em; opacity: 0.85; }
</style>

<script>
<%= raw QrScannerController.vendored_javascript %>
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var scanner = new Html5QrcodeScanner('qr-reader', {
      fps: 10,
      // A fixed pixel qrbox would look lost (or too cramped) once the
      // frame itself scales with the viewport - sizing it as a fraction
      // of whatever the viewfinder actually turns out to be keeps the
      // aiming box proportionate at any screen size.
      qrbox: function (viewfinderWidth, viewfinderHeight) {
        var edge = Math.floor(Math.min(viewfinderWidth, viewfinderHeight) * 0.7);
        return { width: edge, height: edge };
      }
    });
    var resultEl = document.getElementById('qr-scan-result');
    var messageEl = document.getElementById('qr-scan-message');
    var form = document.getElementById('qr-scan-form');
    var urlField = document.getElementById('qr-scan-url');

    // Guards against the decode loop firing again for the same code a
    // frame or two after a scan is already being handled, before
    // scanner.pause() below has actually taken effect.
    var handlingScan = false;

    function showResult(status, message) {
      messageEl.textContent = message;
      resultEl.className = 'qr-scan-result -' + status;
      resultEl.style.display = 'flex';

      // A signal beyond just text/color - useful when the operator isn't
      // looking straight at the screen right after scanning (e.g. still
      // holding the item up to the camera). Quietly does nothing wherever
      // unsupported (iOS Safari, desktop browsers) - a bonus, not
      // something relied on.
      if (status === 'success' && navigator.vibrate) {
        navigator.vibrate(200);
      }
    }

    scanner.render(function (decodedText) {
      if (handlingScan) return;
      handlingScan = true;

      // true also freezes the visible preview on the last frame, which
      // is itself a clear "this is paused" signal, not just a mechanism
      // to stop decoding.
      try { scanner.pause(true); } catch (e) { /* already paused/stopped */ }

      urlField.value = decodedText;

      fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form)
      })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          showResult(data.status, data.message);
        })
        .catch(function () {
          showResult('error', <%= l(:error_qr_scanner_request_failed).to_json.html_safe %>);
        });
    });

    resultEl.addEventListener('click', function () {
      resultEl.style.display = 'none';
      handlingScan = false;
      scanner.resume();
    });
  });
</script>

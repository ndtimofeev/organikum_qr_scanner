<h2><%= l(:label_qr_scanner) %></h2>

<p><%= l(:text_qr_scanner_hint) %></p>

<%# Html5QrcodeScanner (the library's own high-level widget) draws its own
    start button, camera picker, and viewfinder inside this element - there
    is nothing else for this plugin to build a UI around. %>
<div id="qr-reader" style="width: 100%; max-width: 500px;"></div>

<%# A real, ordinary form - not an AJAX call - so a successful scan ends
    in a normal HTTP redirect straight to the issue (or back here with a
    flash message), the same way any other Redmine form submission does.
    form_tag embeds the CSRF token automatically; JS only ever fills in
    the one hidden field and submits. %>
<%= form_tag(scan_qr_scanner_path, id: 'qr-scan-form', style: 'display: none') do %>
  <%= hidden_field_tag :url, '', id: 'qr-scan-url' %>
<% end %>

<script>
<%= raw QrScannerController.vendored_javascript %>
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var scanner = new Html5QrcodeScanner('qr-reader', { fps: 10, qrbox: 250 });

    scanner.render(function (decodedText) {
      // Stop the camera before navigating away - the page unload would
      // do that anyway, but there's no reason to leave it running for
      // even the brief moment the form submission takes.
      scanner.clear().finally(function () {
        document.getElementById('qr-scan-url').value = decodedText;
        document.getElementById('qr-scan-form').submit();
      });
    });
  });
</script>
